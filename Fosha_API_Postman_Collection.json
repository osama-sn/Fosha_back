    {
      "name": "🌴 3. Trips (إدارة الرحلات والبرامج)",
      "item": [
        {
          "name": "3.1 Get All Trips (تصفح الرحلات والبحث المتقدم بكل التفاصيل والفلترة)",
          "request": {
            "auth": {
              "type": "noauth"
