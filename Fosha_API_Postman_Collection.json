                "trips",
                "{{tripId}}"
              ]
            }
          }
        },
        {
          "name": "3.4 Create New Trip (إضافة رحلة جديدة مع اختيار التصنيف ورفع الصور - multipart/form-data)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('tripId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "رحلة إلى دهب وشرم الشيخ",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "رحلة 4 أيام شاملة الإقامة والأنشطة البحرية وسفاري الشروق",
                  "type": "text"
                },
                {
                  "key": "origin",
                  "value": "القاهرة",
                  "type": "text"
                },
                {
                  "key": "destination",
                  "value": "دهب",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "2500",
                  "type": "text"
                },
                {
                  "key": "capacity",
                  "value": "30",
                  "type": "text"
                },
