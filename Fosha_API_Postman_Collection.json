                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "دهب"
                },
                {
                  "key": "origin",
                  "value": "القاهرة"
                },
                {
                  "key": "destination",
                  "value": "دهب"
                },
                {
                  "key": "minPrice",
                  "value": "500"
                },
                {
                  "key": "maxPrice",
                  "value": "5000"
                },
                {
                  "key": "minRating",
                  "value": "4"
                },
                {
                  "key": "category",
                  "value": "sea"
                },
                {
                  "key": "governorate",
                  "value": "القاهرة"
                },
                {
                  "key": "myGovernorateOnly",
                  "value": "false"
                },
                {
                  "key": "sort",
                  "value": "price_asc"
                },
                {
                  "key": "lang",
                  "value": "{{lang}}"
                }
              ]
            }
          }
        },
