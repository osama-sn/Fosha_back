{
  "info": {
    "_postman_id": "fosha-api-collection-v2",
    "name": "Fosha Travel API (فسحة) - Full Multi-Tenant & Home Collection",
    "description": "مجموعة بوست مان الكاملة والشاملة منصة فسحة (Fosha). تشمل الهوم بيج المجمعة، الدخول، التسجيل، السوبر أدمن، المحافظات، تصفية الفئات، الشركات، رحلات وتفاصيلها وتقييماتها، حجوزات، إحصائيات الداشبورد، الخصومات، المفضلة والإشعارات.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "lang",
      "value": "ar",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🏠 0. Home Page (بيانات الهوم بيج المجمعة والبحث السريع)",
      "item": [
        {
          "name": "0.1 Get Home Page Data (جلب بيانات الصفحة الرئيسية الكاملة بطلب واحد)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/home?governorate=القاهرة",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "home"
              ],
              "query": [
                {
                  "key": "governorate",
                  "value": "القاهرة",
                  "description": "اسم المحافظة (في حالة الزائر أو لتغيير المحافظة)"
                }
              ]
            }
          }
        }
      ]
    },
