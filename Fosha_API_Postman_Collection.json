                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/companies?page=1&limit=10&status=active&search=النيل&governorate=القاهرة&minRating=4&sortBy=featured&lang={{lang}}",
